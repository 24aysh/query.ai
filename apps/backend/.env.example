# Query.AI Backend — Environment Variables

# Copy this file to `.env` and fill in your values.
# Never commit the `.env` file — it is already in .gitignore.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant cloud API key (https://cloud.qdrant.io)
QUADRANT_API_KEY=your_qdrant_api_key_here

# Qdrant cluster endpoint (e.g. https://<cluster-id>.<region>.aws.cloud.qdrant.io)
CLUSTER_ENDPOINT=https://your-cluster-endpoint.qdrant.io

# Optional: override the default Qdrant collection name (default: query_ai)
# COLLECTION_NAME=query_ai

# Optional: override the default server port (default: 3001)
# PORT=3001

# Optional: restrict CORS to a specific frontend origin in production
# CORS_ORIGIN=https://your-frontend-domain.com
